// VSCode配置文件
{
  // 标尺
  "editor.rulers": [110],
  // 文件嵌套
  "explorer.fileNesting.enabled": true,
  // // 文件嵌套规则，不设置则使用VScode默认规则
  // "explorer.fileNesting.patterns": {
  //   // 以“package.json”作为头文件，把其它文件都丢进去
  //   "package.json": "package-lock.json, pnpm-lock.yaml, pnpm-workspace.yaml, .git*, LICENSE",
  //   // 以“README.md”作为头文件，把各种config文件都丢进去
  //   "README.md": "README*, *config.json, *config.ts, *config.js",
  //   // 以“global.d.ts”作为头文件，把各种类型注释文件都丢进去
  //   "global.d.ts": "*.d.ts"
  // },
  // Codegeex代码生成器设置
  "Codegeex.RepoIndex": true,
  "Codegeex.Chat.fontSize": 13,
  // VSCode自带的AI功能：关闭
  "chat.disableAIFeatures": true
}
