{
  // 编译器设置
  "compilerOptions": {
    // // 严格的类型检查
    // "strict": true,
    // 强制开启JS类型检查
    "checkJs": true,
    // 路径别名
    "paths": {
      // 把“@”指向根目录
      "@/*": ["./*"]
    }
  },
  // 类型检查排除的文件
  "exclude": [
    // node包
    "node_modules/**",
    // 编译输出目录
    "dist-*/**",
    // public文件夹
    "public/**",
    // 各类缓存文件夹
    "cache/**"
  ]
}
