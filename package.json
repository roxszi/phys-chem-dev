{
  "name": "phys-chem",
  "version": "1.1.0",
  "description": "物化助手，助力物理化学理论与实验教学。",
  "keywords": [],
  "author": "SI_Cheng-Yun",
  "license": "MulanPSL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:frontend",
    "build": "pnpm build:frontend",
    "dev:frontend": "vitepress dev frontend",
    "build:frontend": "pnpm build:frontend:root && pnpm build:frontend:subpage",
    "build:frontend:root": "set VITE_BUILD_KIND=root&& vitepress build frontend",
    "build:frontend:subpage": "set VITE_BUILD_KIND=subpage&& vitepress build frontend",
    "build:frontend:gzip": "pnpm build:frontend:gzip:root && build:frontend:gzip:subpage",
    "build:frontend:gzip:root": "set VITE_BUILD_KIND=root&& node shared/distFrontendGzip.ts",
    "build:frontend:gzip:subpage": "set VITE_BUILD_KIND=subpage&& node shared/distFrontendGzip.ts",
    "preview:frontend": "vitepress preview frontend",
    "dev:backend": "tsx watch src/index.ts",
    "build:backend": "tsc",
    "start:backend": "node dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@tdesign-vue-next/auto-import-resolver": "^0.1.8",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/node": "^26.4.1",
    "@vueuse/core": "^14.4.0",
    "echarts": "^6.1.0",
    "markdown-it-mathjax3": "^4.3.2",
    "ml-matrix": "^6.15.0",
    "tdesign-vue-next": "^1.20.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.42",
    "vue-echarts": "^8.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}